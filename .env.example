# 复制为 .env 后按需修改；.env 不要提交到 Git
APP_NAME=MiniMall
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=minimall:dev

# 用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
